# Copie para .env e preencha só na sua máquina. Não commite o .env.

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimu_pwa_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_SCHEMA=flow

# Obrigatório para login do admin. Gere com: openssl rand -hex 32
JWT_SECRET=

# Obrigatórios para npm run migrate (a senha não tem valor padrão)
ADMIN_USERNAME=
ADMIN_PASSWORD=

CORS_ORIGIN=http://localhost:3000

# Opcional. Usada por GET /api/config/google-maps-key
GOOGLE_MAPS_API_KEY=
